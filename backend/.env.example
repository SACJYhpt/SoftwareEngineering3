# Copy to .env. run.ps1 creates a unique JWT_SECRET automatically.
APP_ENV=development
# Local demonstration only; team integration should use MySQL (see README).
DATABASE_URL=sqlite:///./demo.db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
SCHOOL_EMAIL_DOMAINS=ntou.edu.tw
PUBLIC_BASE_URL=http://localhost:5173
# Deployment: after `npm run build`, point this at frontend/dist so uvicorn serves the site
# and the API (under /api) together; event links still open after a refresh. Then set
# PUBLIC_BASE_URL to this server's address. Leave empty when using `npm run dev`.
# FRONTEND_DIST=../frontend/dist
# Start worker.py to deliver queued messages. No SMTP credentials are committed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=events@ntou.edu.tw
# Opt in after the team confirms backup storage and permissions.
BACKUP_ENABLED=0
# BACKUP_DIR=C:/private-backups/event-registration
# MySQL example (URL-encode special characters in the password):
# DATABASE_URL=mysql+pymysql://event_app:YOUR_PASSWORD@127.0.0.1:3306/event_registration?charset=utf8mb4
