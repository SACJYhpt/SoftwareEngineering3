# Copy to .env. run.ps1 creates a unique JWT_SECRET automatically.
APP_ENV=development
# Local demonstration only; team integration should use MySQL (see README).
DATABASE_URL=sqlite:///./demo.db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# MySQL example (URL-encode special characters in the password):
# DATABASE_URL=mysql+pymysql://event_app:YOUR_PASSWORD@127.0.0.1:3306/event_registration?charset=utf8mb4
